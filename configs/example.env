# Supply the existing database, APP_KEY and OAuth private key through a protected
# deployment environment. This file intentionally contains no usable credentials.
HTTP_ADDR=:8080
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Shanghai
APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_KEY=
APP_LOCK_FILE=storage/go-instance.lock
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=blessingskin
DB_USERNAME=blessingskin
DB_PASSWORD=
DB_PREFIX=
DB_LOGIN_CONNECTIONS=2
DB_BUSINESS_CONNECTIONS=4
DB_WORKER_CONNECTIONS=1
PWD_METHOD=BCRYPT
SALT=
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=null
REMEMBER_LIFETIME=9600h
LOGIN_CONCURRENCY=2
LOGIN_QUEUE=2
LOGIN_WAIT=100ms
# Textures are served from a local directory; other filesystem drivers are
# rejected until their semantics are verified.
FS_DRIVER=local
TEXTURES_DIR=storage/textures
OAUTH_PRIVATE_KEY=storage/oauth-private.key
OAUTH_ACCESS_LIFETIME=8760h
OAUTH_REFRESH_LIFETIME=8760h
OAUTH_CODE_LIFETIME=10m
AUTH_CLEANUP_INTERVAL=1m
AUTH_CLEANUP_BATCH=500
WORKER_POLL_INTERVAL=3s
# Optional authoritative JSON export of the legacy effective cached options.
# Relative paths resolve from this declared environment file (or APP_ROOT).
OPTIONS_SNAPSHOT_FILE=

# Empty MAIL_MAILER disables new mail challenges. SMTP follows the existing
# MAIL_* settings; delivery payloads stay encrypted in the outbox.
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Example
# go-mail's 15s default; must remain below the worker's one-minute lease.
MAIL_SEND_TIMEOUT=15s
# Retains the existing failed-lease delivery cadence.
MAIL_RETRY_DELAY=1m

# Yggdrasil module switches (restart required). Defaults are false.
YGGDRASIL_PUBLICKEYS_ENABLED=false
YGG_VERBOSE_LOG=false
