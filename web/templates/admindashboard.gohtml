{{define "admindashboard"}}
<div class="dashboard-stat-grid">
  <ore-card class="dashboard-stat-card"><ore-container class="dashboard-card-header" variant="light"><h2>{{.AdminUsageUsers}}</h2></ore-container><div class="ore-card-body dashboard-stat-body"><strong class="stats">{{.AdminSumUsers}}</strong><i class="fas fa-users" aria-hidden="true"></i></div><a class="dashboard-stat-footer" href="{{.BaseURL}}/admin/users">{{.Users}} <i class="fa fa-arrow-circle-right" aria-hidden="true"></i></a></ore-card>
  <ore-card class="dashboard-stat-card"><ore-container class="dashboard-card-header" variant="light"><h2>{{.AdminUsagePlayers}}</h2></ore-container><div class="ore-card-body dashboard-stat-body"><strong class="stats">{{.AdminSumPlayers}}</strong><i class="fas fa-gamepad" aria-hidden="true"></i></div><a class="dashboard-stat-footer" href="{{.BaseURL}}/admin/players">{{.PlayerManage}} <i class="fa fa-arrow-circle-right" aria-hidden="true"></i></a></ore-card>
  <ore-card class="dashboard-stat-card"><ore-container class="dashboard-card-header" variant="light"><h2>{{.AdminUsageTextures}}</h2></ore-container><div class="ore-card-body dashboard-stat-body"><strong class="stats">{{.AdminSumTextures}}</strong><i class="fas fa-file" aria-hidden="true"></i></div></ore-card>
  <ore-card class="dashboard-stat-card"><ore-container class="dashboard-card-header" variant="light"><h2>{{.AdminUsageStorage}}</h2></ore-container><div class="ore-card-body dashboard-stat-body"><strong class="stats">{{if gt .AdminSumStorage 1024}}{{.AdminStorageMB}}MB{{else}}{{.AdminSumStorage}}KB{{end}}</strong><i class="fas fa-hdd" aria-hidden="true"></i></div></ore-card>
</div>
<div class="dashboard-admin-grid">
  <ore-card class="dashboard-card dashboard-notification-card"><ore-container class="dashboard-card-header" variant="light"><h2>{{.AdminNotifyTitle}}</h2></ore-container><form method="post" action="{{.BaseURL}}/admin/notifications/send"><input type="hidden" name="_token" value="{{.CSRF}}"><div class="ore-card-body dashboard-card-body">
    {{if .NotificationError}}<div class="dashboard-message dashboard-message-error">{{.NotificationError}}</div>{{end}}
    {{if .NotificationSent}}<div class="dashboard-message dashboard-message-success">{{.NotificationSent}}</div>{{end}}
    <label class="dashboard-form-label">{{.AdminNotifyReceiver}}</label>
    <label class="dashboard-radio"><input type="radio" name="receiver" value="all" required> {{.AdminNotifyAll}}</label>
    <label class="dashboard-radio"><input type="radio" name="receiver" value="normal" required> {{.AdminNotifyNormal}}</label>
    <label class="dashboard-radio"><input type="radio" name="receiver" value="uid" required> {{.AdminNotifyUID}} <ore-textfield type="number" name="uid"></ore-textfield></label>
    <label class="dashboard-radio"><input type="radio" name="receiver" value="email" required> {{.AdminNotifyEmail}} <ore-textfield type="email" name="email"></ore-textfield></label>
    <label class="dashboard-form-label">{{.AdminNotifySubject}}<ore-textfield type="text" name="title" required></ore-textfield></label>
    <label class="dashboard-form-label">{{.AdminNotifyContent}}<ore-textarea name="content"></ore-textarea></label>
  </div><ore-container class="dashboard-card-footer" variant="light"><ore-button type="submit">{{.AdminSubmit}}</ore-button></ore-container></form></ore-card>
  <ore-card class="dashboard-card dashboard-chart-card"><ore-container class="dashboard-card-header" variant="light"><h2>{{.AdminOverview}}</h2></ore-container><div class="ore-card-body dashboard-card-body"><div class="chart" id="chart-users-registration"></div><div class="chart" id="chart-textures-upload"></div></div></ore-card>
</div>{{end}}
