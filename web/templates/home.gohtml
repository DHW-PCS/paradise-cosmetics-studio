{{define "home"}}<body class="hold-transition layout-top-nav">
<div class="hp-wrapper" style="{{if .FixedBackground}}background-color: rgba(0, 0, 0, 0){{else}}background-image: url('{{.HomePicture}}'){{end}}">
{{if .FixedBackground}}<div id="fixed-bg" style="background-image: url('{{.HomePicture}}')"></div>{{end}}
<div id="home-navbar" data-navbar-class="fixed-top {{if .TransparentNavbar}}transparent{{end}}"><a href="{{.BaseURL}}/" class="ore-navbar-title">{{.SiteName}}</a><div class="ore-navbar-actions"><a class="ore-navbar-action" href="{{.BaseURL}}/skinlib">{{.Skinlib}}</a>
<ore-dropdown class="home-nav-dropdown"><button class="ore-dropdown-trigger ore-navbar-action" type="button"><i class="fas fa-language" aria-hidden="true"></i><span>{{.CurrentLanguage}}</span></button><div class="ore-dropdown-menu">{{range .Languages}}<a class="ore-dropdown-item locale" data-value="{{.URL}}" href="{{.URL}}">{{.Name}}</a>{{end}}</div></ore-dropdown>
{{if .User}}<ore-dropdown class="home-nav-dropdown home-user-dropdown user-menu"><button class="ore-dropdown-trigger ore-navbar-action" type="button" aria-label="{{.Nickname}}"><picture><source srcset="{{.AvatarWebP}}" type="image/webp"><img src="{{.AvatarPNG}}" class="pcs-avatar" alt=""></picture><span class="sr-only" data-mark="nickname">{{.Nickname}}</span></button><div class="ore-dropdown-menu"><a class="ore-dropdown-item" data-value="{{.BaseURL}}/user" href="{{.BaseURL}}/user">{{.UserCenter}}</a><a class="ore-dropdown-item" data-value="{{.BaseURL}}/user/profile" href="{{.BaseURL}}/user/profile">{{.Profile}}</a>{{if .Admin}}<a class="ore-dropdown-item" data-value="{{.BaseURL}}/admin" href="{{.BaseURL}}/admin">{{.AdminPanel}}</a><a class="ore-dropdown-item" data-value="{{.BaseURL}}/admin/users" href="{{.BaseURL}}/admin/users">{{.Users}}</a><a class="ore-dropdown-item" data-value="{{.BaseURL}}/admin/reports" href="{{.BaseURL}}/admin/reports">{{.Reports}}</a>{{end}}<button class="ore-dropdown-item" id="home-logout-button" type="button" data-value="logout">{{.Logout}}</button></div></ore-dropdown>{{else}}<a class="ore-navbar-action" href="{{.BaseURL}}/auth/login"><i class="icon fas fa-sign-in-alt"></i>{{.LoginLabel}}</a>{{end}}</div></div>
<div class="container"><div class="splash"><h1 class="splash-head">{{.SiteName}}</h1><p class="splash-subhead">{{.SiteDescription}}</p><div class="splash-action" data-oreui-button data-href="{{if .User}}{{.BaseURL}}/user{{else}}{{.BaseURL}}/auth/register{{end}}" data-label="{{if .User}}{{.UserCenter}}{{else}}{{.RegisterLabel}}{{end}}"></div></div></div>
{{if .HideIntroduction}}<div id="copyright" class="without-intro"><div class="container">{{template "copyright" .}}</div></div>{{end}}</div>
{{if not .HideIntroduction}}<div id="intro"><div class="container"><div class="text-center"><h1>{{index .Texts "index.features.title"}}</h1><br><br><div class="container-lg"><div class="row">{{range .Features}}<div class="col-lg"><i class="fas {{.Icon}} mb-3" aria-hidden="true"></i><h3>{{.Name}}</h3><p>{{.Description}}</p></div>{{end}}</div></div></div><br></div></div><div id="footer-wrap"><div class="container"><div class="row"><div class="col-lg-6 mb-2">{{index .Texts "index.introduction"}}</div><div class="col-lg-4"></div><div class="col-lg-2 d-flex justify-content-center align-items-center"><div data-oreui-button data-href="{{.BaseURL}}/auth/register" data-label="{{index .Texts "index.start"}}"></div></div></div></div></div><div id="copyright" class="with-intro"><div class="container">{{template "copyright" .}}</div></div>{{end}}
{{end}}
