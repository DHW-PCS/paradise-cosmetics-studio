{{define "home"}}<body class="hold-transition layout-top-nav">
<div class="hp-wrapper" style="{{if .FixedBackground}}background-color: rgba(0, 0, 0, 0){{else}}background-image: url('{{.HomePicture}}'){{end}}">
{{if .FixedBackground}}<div id="fixed-bg" style="background-image: url('{{.HomePicture}}')"></div>{{end}}
<nav class="navbar navbar-expand fixed-top navbar-{{.NavbarColor}} navbar-{{.NavbarMode}} ml-0 {{if .TransparentNavbar}}transparent{{end}}"><div class="container"><div class="navbar-header"><a href="{{.BaseURL}}/" class="navbar-brand">{{.SiteName}}</a></div><div class="navbar-custom-menu"><ul class="nav navbar-nav"><li class="nav-item"><a class="nav-link" href="{{.BaseURL}}/skinlib">{{.Skinlib}}</a></li>
<li class="nav-item dropdown"><a class="nav-link" data-toggle="dropdown" href="#"><i class="fas fa-language" aria-hidden="true"></i><span class="d-none d-sm-inline">{{.CurrentLanguage}}</span></a><div class="dropdown-menu dropdown-menu-lg dropdown-menu-right">{{range .Languages}}<a class="dropdown-item locale" href="{{.URL}}">{{.Name}}</a><div class="dropdown-divider"></div>{{end}}</div></li>
{{if .User}}{{template "user-menu" .}}{{else}}<li class="nav-item"><a class="nav-link" href="{{.BaseURL}}/auth/login"><i class="icon fas fa-sign-in-alt"></i>{{.LoginLabel}}</a></li>{{end}}</ul></div></div></nav>
<div class="container"><div class="splash"><h1 class="splash-head">{{.SiteName}}</h1><p class="splash-subhead">{{.SiteDescription}}</p><p>{{if .User}}<a href="{{.BaseURL}}/user" class="main-button">{{.UserCenter}}</a>{{else}}<a href="{{.BaseURL}}/auth/register" class="main-button">{{.RegisterLabel}}</a>{{end}}</p></div></div>
{{if .HideIntroduction}}<div id="copyright" class="without-intro"><div class="container">{{template "copyright" .}}</div></div>{{end}}</div>
{{if not .HideIntroduction}}<div id="intro"><div class="container"><div class="text-center"><h1>{{index .Texts "index.features.title"}}</h1><br><br><div class="container-lg"><div class="row">{{range .Features}}<div class="col-lg"><i class="fas {{.Icon}} mb-3" aria-hidden="true"></i><h3>{{.Name}}</h3><p>{{.Description}}</p></div>{{end}}</div></div></div><br></div></div><div id="footer-wrap"><div class="container"><div class="row"><div class="col-lg-6 mb-2">{{index .Texts "index.introduction"}}</div><div class="col-lg-4"></div><div class="col-lg-2 d-flex justify-content-center align-items-center"><a href="{{.BaseURL}}/auth/register" class="main-button">{{index .Texts "index.start"}}</a></div></div></div></div><div id="copyright" class="with-intro"><div class="container">{{template "copyright" .}}</div></div>{{end}}
{{end}}
