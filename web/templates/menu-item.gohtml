{{define "menu-item"}}{{if .Children}}<ore-accordion class="app-sidebar-accordion" {{if .Active}}open{{end}}><ore-icon-button class="ore-accordion-trigger" type="button" color="primary"><span class="ore-accordion-title"><i class="fas {{.Icon}}" aria-hidden="true"></i>{{.Title}}</span></ore-icon-button><div class="ore-accordion-content"><div class="app-sidebar-menu-children">{{range .Children}}{{template "menu-item" .}}{{end}}</div></div></ore-accordion>{{else}}<ore-container class="app-sidebar-menu-item" variant="dark"><a class="app-sidebar-menu-link {{if .Active}}active{{end}}" href="{{.URL}}" {{if .Active}}aria-current="page"{{end}}><i class="fas {{.Icon}}" aria-hidden="true"></i><span>{{.Title}}</span></a></ore-container>{{end}}{{end}}
