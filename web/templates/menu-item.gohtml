{{define "menu-item"}}<li class="nav-item {{if .Active}}active menu-open{{end}}"><a class="nav-link {{if .Active}}active{{end}}" href="{{.URL}}"><i class="nav-icon fas {{.Icon}}"></i><p>{{.Title}}{{if .Children}}<i class="right fas fa-angle-left"></i>{{end}}</p></a>{{if .Children}}<ul class="nav nav-treeview">{{range .Children}}{{template "menu-item" .}}{{end}}</ul>{{end}}</li>{{end}}
