{{define "yggdrasilreadme"}}<div class="card card-secondary"><div class="card-header"><h3 class="card-title">{{.YggReadme.Title}}</h3></div><div class="card-body">{{.YggReadme.Content}}</div><div class="card-footer"><button class="btn bg-primary" onclick="history.back()">{{.YggReadme.Back}}</button></div></div>{{end}}
