{{define "page"}}<!DOCTYPE html>
<html lang="{{.Language}}"><head>
{{template "head" .}}
<title>{{if .Home}}{{.SiteName}}{{else}}{{.Title}} - {{.SiteName}}{{end}}</title>
{{if .Home}}<link rel="preload" as="image" href="{{.HomePicture}}">{{range .HomeCSS}}<link rel="stylesheet" href="{{.}}">{{end}}{{end}}
</head>
{{if .Home}}{{template "home" .}}{{else if .Login}}
<body class="auth-page"><div class="auth-frame">{{if or .Bind .Verify}}<section class="auth-server-panel">{{if .LoginNotice}}<p class="auth-notice">{{.LoginNotice}}</p>{{end}}{{if or .Bind .Verify}}<form method="post" {{if .Bind}}id="login-form" action="{{.BaseURL}}/auth/bind"{{end}}><input type="hidden" name="_token" value="{{.CSRF}}"><label class="auth-server-label">{{index .Texts "auth.email"}}<input name="email" type="email" {{if .Verify}}required{{end}}></label>{{if .Bind}}<p class="auth-server-message">{{.FormIntroduction}}</p>{{end}}{{if .FormError}}<p class="auth-server-message">{{.FormError}}</p>{{end}}<button type="submit">{{.FormButton}}</button></form>{{end}}</section>{{else}}<main class="auth-root" data-notice="{{.LoginNotice}}"></main>{{end}}{{if eq (index .Globals "route") "auth/login"}}<p class="auth-login-register"><a class="auth-link" href="{{.BaseURL}}/auth/register">{{.RegisterLink}}</a></p>{{end}}</div>
{{else}}
<body class="{{if .Dark}}dark-mode {{end}}hold-transition sidebar-mini"><div class="wrapper">
<nav class="main-header navbar navbar-expand navbar-{{.NavbarColor}} navbar-{{.NavbarMode}}">
<ul class="navbar-nav"><li class="nav-item"><a class="nav-link" data-widget="pushmenu" href="#"><i class="fas fa-bars"></i></a></li></ul>
<ul class="navbar-nav ml-auto"><li class="nav-item" id="toggle-dark-mode"></li>
<li class="nav-item dropdown" data-t="{{.NoUnread}}" data-notifications="{{.NotificationsJSON}}"></li>
<li class="nav-item dropdown"><a class="nav-link" data-toggle="dropdown" href="#"><i class="fas fa-language" aria-hidden="true"></i><span class="d-none d-sm-inline">{{.CurrentLanguage}}</span></a><div class="dropdown-menu dropdown-menu-lg dropdown-menu-right">{{range .Languages}}<a class="dropdown-item locale" href="{{.URL}}">{{.Name}}</a><div class="dropdown-divider"></div>{{end}}</div></li>
{{template "user-menu" .}}</ul></nav>
<aside class="main-sidebar sidebar-{{.SidebarColor}} elevation-3"><a href="{{.BaseURL}}/" class="brand-link text-center"><span class="brand-text font-weight-light">{{.SiteName}}</span></a><div class="sidebar"><div class="user-panel mt-3 mb-3 {{if .Admin}}pb-2{{end}}"><div class="d-flex"><div class="image"><picture><source srcset="{{.AvatarWebP}}" type="image/webp"><img src="{{.AvatarPNG}}" class="pcs-avatar" alt="User Image"></picture></div><div class="info"><a class="d-block" data-mark="nickname">{{.Nickname}}</a></div></div>{{if .Admin}}<div class="mt-3 ml-2 mr-2 d-flex flex-wrap"><span class="badge bg-primary mb-1 mr-2">STAFF</span></div>{{end}}</div><nav class="mt-2"><ul class="nav nav-pills nav-sidebar flex-column nav-child-indent" data-widget="treeview" role="menu">
{{range .MenuGroups}}<li class="nav-header">{{.Title}}</li>{{range .Items}}{{template "menu-item" .}}{{end}}{{end}}
</ul></nav></div></aside>
<div class="content-wrapper"><div class="content-header"><div class="container-fluid"><h1 class="m-0">{{.Title}}</h1></div></div><section class="content"><div class="container-fluid">{{if .ProfilePage}}{{template "profile" .}}{{end}}{{if .PlayersPage}}{{template "players" .}}{{end}}{{if .ClosetPage}}{{template "closet" .}}{{end}}{{if .ReportsPage}}{{template "reports" .}}{{end}}{{if .InvitationCodesPage}}{{template "invitationcodes" .}}{{end}}{{if .YggdrasilConfigPage}}{{template "yggdrasilconfig" .}}{{end}}{{if .YggdrasilLogPage}}{{template "yggdrasillog" .}}{{end}}{{if .ReadmePage}}{{template "yggdrasilreadme" .}}{{end}}{{if .AdminDashboardPage}}{{template "admindashboard" .}}{{end}}{{if eq (index .Globals "route") "user"}}{{if .YggDnd}}{{template "yggdrasildnd" .}}{{end}}<div class="row"><div class="col-md-7"><div id="email-verification"></div><div id="usage-box"></div></div><div class="col-md-5"><div class="card card-primary card-outline"><div class="card-header"><h3 class="card-title">{{.AnnouncementTitle}}</h3>{{if .Admin}}&nbsp;<a href="{{.BaseURL}}/admin/options"><i class="fas fa-edit"></i></a>{{end}}</div><div class="card-body">{{.Announcement}}</div></div></div></div>{{end}}</div></section></div>
{{if eq (index .Globals "route") "user"}}<div id="modal-score-instruction" class="modal fade" tabindex="-1" role="dialog"><div class="modal-dialog modal-lg"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">{{.ScoreTitle}}</h5><button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button></div><div class="modal-body">{{.ScoreIntroduction}}<hr><div class="row"><div class="col-md-4"><p class="text-center">{{.ScoreStorage}}</p></div><div class="col-md-4"><p class="text-center">{{.ScorePlayer}}</p></div><div class="col-md-4"><p class="text-center">{{.ScoreCloset}}</p></div></div></div><div class="modal-footer"><button class="btn btn-default" data-dismiss="modal">{{.Close}}</button></div></div></div></div>{{end}}
<footer class="main-footer">{{template "copyright" .}}</footer></div>
{{end}}
<script id="pcs-extra" type="application/json">{{.Extra}}</script>
{{range .HomeJS}}<script src="{{.}}"></script>{{end}}
{{range .AppJS}}<script src="{{.}}"></script>{{end}}
{{.Scripts}}{{if .CustomJS}}<script>{{.CustomJS}}</script>{{end}}{{.ExtraFoot}}
</body></html>{{end}}
