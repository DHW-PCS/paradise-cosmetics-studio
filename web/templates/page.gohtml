{{define "page"}}<!DOCTYPE html>
<html lang="{{.Language}}"><head>
{{template "head" .}}
<title>{{if .Home}}{{.SiteName}}{{else}}{{.Title}} - {{.SiteName}}{{end}}</title>
{{if .Home}}<link rel="preload" as="image" href="{{.HomePicture}}">{{range .HomeCSS}}<link rel="stylesheet" href="{{.}}">{{end}}{{end}}
</head>
{{if .Home}}{{template "home" .}}{{else if .Login}}
<body class="auth-page"><div class="auth-frame">{{if or .Bind .Verify}}<section class="auth-server-panel">{{if .LoginNotice}}<p class="auth-notice">{{.LoginNotice}}</p>{{end}}{{if or .Bind .Verify}}<form method="post" {{if .Bind}}id="login-form" action="{{.BaseURL}}/auth/bind"{{end}}><input type="hidden" name="_token" value="{{.CSRF}}"><label class="auth-server-label">{{index .Texts "auth.email"}}<ore-textfield name="email" type="email" {{if .Verify}}required{{end}}></ore-textfield></label>{{if .Bind}}<p class="auth-server-message">{{.FormIntroduction}}</p>{{end}}{{if .FormError}}<p class="auth-server-message">{{.FormError}}</p>{{end}}<button type="submit">{{.FormButton}}</button></form>{{end}}</section>{{else}}<main class="auth-root" data-notice="{{.LoginNotice}}"></main>{{end}}{{if eq (index .Globals "route") "auth/login"}}<p class="auth-login-register"><a class="auth-link" href="{{.BaseURL}}/auth/register">{{.RegisterLink}}</a></p>{{end}}</div>
{{else}}
<body class="{{if .Dark}}dark-mode {{end}}hold-transition sidebar-mini"><div class="wrapper">
<ore-navbar class="app-navbar">
<div class="ore-navbar-start"><button class="ore-navbar-button" type="button" data-widget="pushmenu" aria-label="Toggle navigation"><i class="fas fa-bars" aria-hidden="true"></i></button></div>
<h1 class="ore-navbar-title app-navbar-title">{{.Title}}</h1>
<div class="ore-navbar-actions"><div class="app-navbar-notifications" data-t="{{.NoUnread}}" data-notifications="{{.NotificationsJSON}}"></div>
<ore-dropdown class="app-navbar-dropdown"><button class="ore-dropdown-trigger app-navbar-action" type="button"><i class="fas fa-language" aria-hidden="true"></i><span>{{.CurrentLanguage}}</span></button><div class="ore-dropdown-menu">{{range .Languages}}<a class="ore-dropdown-item locale" data-value="{{.URL}}" href="{{.URL}}">{{.Name}}</a>{{end}}</div></ore-dropdown>
{{template "user-menu" .}}</div></ore-navbar>
<aside class="main-sidebar sidebar-{{.SidebarColor}} elevation-3 app-sidebar"><ore-container class="app-sidebar-header auth-option-container" variant="light"><a href="{{.BaseURL}}/" class="app-sidebar-brand">{{.SiteName}}</a></ore-container><div class="sidebar app-sidebar-layout"><ore-container class="app-sidebar-user auth-option-container" variant="light"><div class="app-sidebar-user-row"><picture><source srcset="{{.AvatarWebP}}" type="image/webp"><img src="{{.AvatarPNG}}" class="pcs-avatar" alt=""></picture><span data-mark="nickname">{{.Nickname}}</span></div>{{if .Admin}}<span class="app-sidebar-role">STAFF</span>{{end}}</ore-container><div class="app-sidebar-scroll"><nav class="app-sidebar-list mt-2"><div class="app-sidebar-menu">
{{range .MenuGroups}}<ore-accordion class="app-sidebar-group" default-open><ore-icon-button class="ore-accordion-trigger" type="button" color="primary"><span class="ore-accordion-title">{{.Title}}</span></ore-icon-button><div class="ore-accordion-content"><div class="app-sidebar-group-content">{{range .Items}}{{template "menu-item" .}}{{end}}</div></div></ore-accordion>{{end}}
</div></nav></div><ore-container class="app-sidebar-footer auth-option-container" variant="light">{{if .Version}}v{{.Version}}{{end}}</ore-container></div></aside>
<div class="content-wrapper"><ore-scrollbar class="app-content-scroll"><section class="content"><div class="container-fluid">{{if .ProfilePage}}{{template "profile" .}}{{end}}{{if .PlayersPage}}{{template "players" .}}{{end}}{{if .ClosetPage}}{{template "closet" .}}{{end}}{{if .ReportsPage}}{{template "reports" .}}{{end}}{{if .InvitationCodesPage}}{{template "invitationcodes" .}}{{end}}{{if .YggdrasilConfigPage}}{{template "yggdrasilconfig" .}}{{end}}{{if .YggdrasilLogPage}}{{template "yggdrasillog" .}}{{end}}{{if .ReadmePage}}{{template "yggdrasilreadme" .}}{{end}}{{if .AdminDashboardPage}}{{template "admindashboard" .}}{{end}}{{if eq (index .Globals "route") "user"}}<div class="row"><div class="col-md-7"><div id="email-verification"></div><div id="usage-box"></div></div><div class="col-md-5"><ore-card class="user-card"><ore-container class="user-card-header" variant="light"><h2>{{.AnnouncementTitle}}</h2>{{if .Admin}}<a href="{{.BaseURL}}/admin/options" aria-label="{{.AnnouncementTitle}}"><i class="fas fa-edit"></i></a>{{end}}</ore-container><div class="ore-card-body user-card-body">{{.Announcement}}</div></ore-card>{{if .YggDnd}}{{template "yggdrasildnd" .}}{{end}}</div></div>{{end}}</div></section></ore-scrollbar></div>
{{if eq (index .Globals "route") "user"}}<div id="modal-score-instruction" class="modal fade" tabindex="-1" role="dialog"><div class="modal-dialog modal-lg"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">{{.ScoreTitle}}</h5><button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button></div><div class="modal-body">{{.ScoreIntroduction}}<hr><div class="row"><div class="col-md-4"><p class="text-center">{{.ScoreStorage}}</p></div><div class="col-md-4"><p class="text-center">{{.ScorePlayer}}</p></div><div class="col-md-4"><p class="text-center">{{.ScoreCloset}}</p></div></div></div><div class="modal-footer"><button class="btn btn-default" data-dismiss="modal">{{.Close}}</button></div></div></div></div>{{end}}
<footer class="main-footer">{{template "copyright" .}}</footer></div>
{{end}}
<script id="pcs-extra" type="application/json">{{.Extra}}</script>
{{range .HomeJS}}<script src="{{.}}"></script>{{end}}
{{range .AppJS}}<script src="{{.}}"></script>{{end}}
{{.Scripts}}{{if .CustomJS}}<script>{{.CustomJS}}</script>{{end}}{{.ExtraFoot}}
</body></html>{{end}}
