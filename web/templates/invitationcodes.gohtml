{{define "invitationcodes"}}<div class="row"><div class="col-md-6"><div class="card card-success"><div class="card-header"><h3 class="card-title">{{.Invitation.FreeTitle}}</h3></div><div class="card-body p-0"><table class="table table-hover"><thead><tr><th>{{.Invitation.CodeLabel}}</th><th>{{.Invitation.GeneratedAtLabel}}</th></tr></thead><tbody>{{if .Invitation.Free}}{{range .Invitation.Free}}<tr><td>{{.Code}}</td><td>{{.GeneratedAt}}</td></tr>{{end}}{{else}}<tr><td colspan="2">{{.Invitation.FreeEmpty}}</td></tr>{{end}}</tbody></table></div><div class="card-footer"><form method="post" action="{{.BaseURL}}/admin/invitation-codes/generate"><input type="hidden" name="_token" value="{{.CSRF}}"><div class="input-group mb-2"><div class="input-group-prepend"><span class="input-group-text">{{.Invitation.AmountLabel}}</span></div><input type="number" class="form-control" name="amount" style="width: 50%;" placeholder="{{.Invitation.AmountPlaceholder}}"></div>{{if .Invitation.Error}}<div class="alert alert-danger">{{.Invitation.Error}}</div>{{end}}<button type="submit" class="btn btn-primary">{{.Invitation.GenerateTitle}}</button></form></div></div></div><div class="col-md-6"><div class="card card-secondary"><div class="card-header"><h3 class="card-title">{{.Invitation.UsedTitle}}</h3></div><div class="card-body p-0"><table class="table table-hover"><thead><tr><th>{{.Invitation.CodeLabel}}</th><th>{{.Invitation.GeneratedAtLabel}}</th><th>{{.Invitation.UserLabel}}</th><th>{{.Invitation.UsedAtLabel}}</th></tr></thead><tbody>{{if .Invitation.Used}}{{range .Invitation.Used}}<tr><td>{{.Code}}</td><td>{{.GeneratedAt}}</td><td>{{.UsedBy}}</td><td>{{.UsedAt}}</td></tr>{{end}}{{else}}<tr><td colspan="4">{{.Invitation.UsedEmpty}}</td></tr>{{end}}</tbody></table></div></div></div></div>{{end}}
