{{define "reports"}}<div class="card"><div class="card-body p-0"><table class="table table-striped">
<thead><tr><th>{{.ReportTID}}</th><th>{{.ReportReason}}</th><th>{{.ReportStatus}}</th><th>{{.ReportTime}}</th></tr></thead>
<tbody>{{range .ReportRows}}<tr><td>{{.TID}}&nbsp;<a href="{{$.BaseURL}}/skinlib/show/{{.TID}}" target="_blank"><i class="fas fa-share"></i></a></td><td>{{.Reason}}</td><td>{{.Status}}</td><td>{{.ReportAt}}</td></tr>{{end}}</tbody>
</table></div>{{template "pagination-footer" .ReportPaginator}}</div>{{end}}
{{define "pagination-footer"}}{{if and . .Links}}<div class="card-footer"><div class="float-right">{{template "pagination-links" .Links}}</div></div>{{end}}{{end}}
{{define "pagination-links"}}<nav><ul class="pagination">
{{range .}}{{if eq .Label "pagination.previous"}}{{if .URL}}<li class="page-item"><a class="page-link" href="{{.URL}}" rel="prev" aria-label="pagination.previous">&lsaquo;</a></li>{{else}}<li class="page-item disabled" aria-disabled="true" aria-label="pagination.previous"><span class="page-link" aria-hidden="true">&lsaquo;</span></li>{{end}}
{{else if eq .Label "pagination.next"}}{{if .URL}}<li class="page-item"><a class="page-link" href="{{.URL}}" rel="next" aria-label="pagination.next">&rsaquo;</a></li>{{else}}<li class="page-item disabled" aria-disabled="true" aria-label="pagination.next"><span class="page-link" aria-hidden="true">&rsaquo;</span></li>{{end}}
{{else if eq .Label "..."}}<li class="page-item disabled" aria-disabled="true"><span class="page-link">...</span></li>
{{else if .Active}}<li class="page-item active" aria-current="page"><span class="page-link">{{.Label}}</span></li>
{{else}}<li class="page-item"><a class="page-link" href="{{.URL}}">{{.Label}}</a></li>{{end}}{{end}}
</ul></nav>{{end}}
