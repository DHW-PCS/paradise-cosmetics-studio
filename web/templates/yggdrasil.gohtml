{{define "yggdrasilconfig"}}<style>ore-textarea .ore-textarea-input{font-family:"SFMono-Regular",Consolas,"Liberation Mono",Menlo,Courier,monospace}</style><div class="row"><div class="col-md-6"><div class="card card-default"><div class="card-header"><h3 class="card-title">{{.YggConfig.CommonTitle}}</h3></div><form method="post" action="{{.BaseURL}}/admin/plugins/config/yggdrasil-api"><input type="hidden" name="_token" value="{{.CSRF}}"><input type="hidden" name="option" value="common"><div class="card-body"><div class="container-fluid">{{if .YggConfig.Saved}}<div class="alert alert-success"><i class="fas fa-check icon"></i><span>{{.YggConfig.Saved}}</span></div>{{end}}<div class="row mb-3"><div class="col-sm-4">{{.YggConfig.UUIDAlgorithmTitle}}</div><div class="col-sm-8"><select class="form-control" name="ygg_uuid_algorithm"><option value="v3"{{if eq (index .YggConfig.Values "ygg_uuid_algorithm") "v3"}} selected{{end}}>{{.YggConfig.UUIDV3}}</option><option value="v4"{{if eq (index .YggConfig.Values "ygg_uuid_algorithm") "v4"}} selected{{end}}>{{.YggConfig.UUIDV4}}</option></select><p class="description">{{.YggConfig.UUIDHint}}</p></div></div><div class="row my-3"><div class="col-sm-4">{{.YggConfig.TokenExpire1Title}}</div><div class="col-sm-8"><ore-textfield type="text" name="ygg_token_expire_1" value="{{index .YggConfig.Values "ygg_token_expire_1"}}"></ore-textfield></div></div><div class="row my-3"><div class="col-sm-4">{{.YggConfig.TokenExpire2Title}}</div><div class="col-sm-8"><ore-textfield type="text" name="ygg_token_expire_2" value="{{index .YggConfig.Values "ygg_token_expire_2"}}"></ore-textfield><p class="description">{{.YggConfig.TokenExpire2Desc}}</p></div></div><div class="row my-3"><div class="col-sm-4">{{.YggConfig.TokensLimitTitle}}</div><div class="col-sm-8"><ore-textfield type="text" name="ygg_tokens_limit" value="{{index .YggConfig.Values "ygg_tokens_limit"}}"></ore-textfield><p class="description">{{.YggConfig.TokensLimitDesc}}</p></div></div><div class="row my-3"><div class="col-sm-4">{{.YggConfig.RateLimitTitle}}</div><div class="col-sm-8"><ore-textfield type="text" name="ygg_rate_limit" value="{{index .YggConfig.Values "ygg_rate_limit"}}"></ore-textfield><p class="description">{{.YggConfig.RateLimitHint}}</p></div></div><div class="row my-3"><div class="col-sm-4">{{.YggConfig.SkinDomainTitle}}</div><div class="col-sm-8"><ore-textfield type="text" name="ygg_skin_domain" value="{{index .YggConfig.Values "ygg_skin_domain"}}"></ore-textfield><p class="description">{{.YggConfig.SkinDomainDesc}}</p></div></div><div class="row my-3"><div class="col-sm-4">{{.YggConfig.SearchMaxTitle}}</div><div class="col-sm-8"><ore-textfield type="text" name="ygg_search_profile_max" value="{{index .YggConfig.Values "ygg_search_profile_max"}}"></ore-textfield><p class="description">{{.YggConfig.SearchMaxHint}}</p></div></div><div class="row my-3"><div class="col-sm-4">{{.YggConfig.ShowConfigTitle}}</div><div class="col-sm-8"><label><input type="checkbox" name="ygg_show_config_section" value="true"{{if .YggConfig.ShowConfigChecked}} checked{{end}}> {{.YggConfig.ShowConfigLabel}}</label></div></div><div class="row mt-3"><div class="col-sm-4">{{.YggConfig.EnableAliTitle}}</div><div class="col-sm-8"><label><input type="checkbox" name="ygg_enable_ali" value="true"{{if .YggConfig.EnableAliChecked}} checked{{end}}> {{.YggConfig.EnableAliLabel}}</label></div></div></div></div><div class="card-footer"><ore-button type="submit">{{.YggConfig.SubmitLabel}}</ore-button></div></form></div></div><div class="col-md-6"><div class="card card-success"><div class="card-header"><h3 class="card-title"><i class="fa fa-star"></i> API Root</h3></div><div class="card-body"><p>{{.YggConfig.APIRootLabel}}<code>{{.YggConfig.APIRoot}}</code></p><p>{{.YggConfig.APIRootNotice}}</p></div></div><div class="card card-default"><div class="card-header"><h3 class="card-title">{{.YggConfig.KeypairTitle}}</h3></div><form method="post" action="{{.BaseURL}}/admin/plugins/config/yggdrasil-api"><input type="hidden" name="_token" value="{{.CSRF}}"><input type="hidden" name="option" value="keypair"><div class="card-body"><div class="callout callout-info">{{.YggConfig.KeypairMessage}}</div>{{if .YggConfig.PrivateKeyValid}}<div class="alert alert-success"><i class="fas fa-check icon"></i><span>{{.YggConfig.ValidLabel}}</span></div>{{else}}<div class="alert alert-danger"><i class="fas fa-times-circle icon"></i><span>{{.YggConfig.InvalidLabel}}</span></div>{{end}}<div class="form-group"><label>{{.YggConfig.PrivateKeyTitle}}</label><ore-textarea name="ygg_private_key" value="{{index .YggConfig.Values "ygg_private_key"}}"></ore-textarea><p class="description">{{.YggConfig.PrivateKeyHint}}</p></div></div><div class="card-footer"><ore-button type="button" name="generate-key">{{.YggConfig.GenerateLabel}}</ore-button><ore-button type="submit" class="ml-2">{{.YggConfig.SubmitLabel}}</ore-button></div></form></div></div></div>{{end}}
{{define "yggdrasillog"}}<div class="card"><div class="card-body p-0"><table class="table table-striped"><thead><tr><th>#</th><th>{{.YggLog.ActionLabel}}</th><th>UID</th><th>PID</th><th>{{.YggLog.ParamsLabel}}</th><th>IP</th><th>{{.YggLog.TimeLabel}}</th></tr></thead><tbody>{{if .YggLog.Rows}}{{range .YggLog.Rows}}<tr><td>{{.ID}}</td><td>{{.ActionLabel}}</td><td>{{.UserID}}</td><td>{{.PlayerID}}</td><td><code>{{.Parameters}}</code></td><td>{{.IP}}</td><td>{{.Time}}</td></tr>{{end}}{{else}}<tr><td colspan="7">{{.YggLog.NoRecords}}</td></tr>{{end}}</tbody></table></div><div class="card-footer"><div class="float-right">{{if .YggLog.HasPrev}}<ore-button color="secondary" href="{{.YggLog.PrevURL}}">&laquo;</ore-button>{{end}}{{if .YggLog.HasNext}}<ore-button color="secondary" href="{{.YggLog.NextURL}}">&raquo;</ore-button>{{end}}</div></div></div>{{end}}
{{define "yggdrasildnd"}}<ore-card class="user-card"><ore-container class="user-card-header" variant="light"><h2>{{.YggDnd.Title}}</h2></ore-container><div class="ore-card-body user-card-body"><p>{{.YggDnd.URLLabel}}<code>{{.YggDnd.APIRoot}}</code></p><p>{{.YggDnd.Tip}}</p></div><ore-container class="user-card-footer" variant="light"><ore-button id="ygg-dnd-button" draggable="true" data-clipboard-text="{{.YggDnd.APIRoot}}">{{.YggDnd.Button}}</ore-button><ore-button color="secondary" target="_blank" href="https://blessing.netlify.app/yggdrasil-api/authlib-injector.html">{{.YggDnd.Guide}} (Blessing Skin)</ore-button></ore-container></ore-card>{{end}}
