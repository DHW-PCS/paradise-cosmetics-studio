{{define "error"}}<!DOCTYPE html><html lang="{{.Language}}"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><meta name="robots" content="noindex,nofollow"><title>{{.Title}} - {{.SiteName}}</title>{{range .CSS}}<link rel="stylesheet" href="{{.}}">{{end}}</head><body class="bg-gray"><div class="text-right m-2 p-2">{{range .Languages}}<a href="{{.URL}}" class="mx-2 p-1 label label-secondary">{{.Name}}</a>{{end}}</div><div class="hero d-flex"><div class="hero-body text-center"><h1><a class="text-primary" href="{{.BaseURL}}/">{{.SiteName}}</a></h1><div class="divider"></div><h3 style="margin-top:15vh">{{.Title}}</h3><p>{{.Detail}}</p><div class="divider"></div>{{if .Admin}}<a class="btn btn-link" href="https://blessing.netlify.com/faq.html" target="_blank">Blessing Skin FAQ</a>{{end}}</div></div></body></html>{{end}}
